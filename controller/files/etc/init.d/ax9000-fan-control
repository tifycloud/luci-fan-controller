#!/bin/sh /etc/rc.common

START=20
STOP=90
USE_PROCD=1

COMMON=${AX9000_COMMON:-/usr/libexec/ax9000-fan-common}
[ -r "$COMMON" ] || exit 1
. "$COMMON"

service_triggers() {
	# procd restarts the supervised process after UCI changes. start_service
	# always drives full speed before launching the new instance.
	procd_add_reload_trigger ax9000-fan
}

start_service() {
	board=$(ax9000_board_name 2>/dev/null || true)
	if ! ax9000_supported_board "$board"; then
		ax9000_write_fault "unsupported_board:${board:-unknown}"
		ax9000_log "refusing unsupported/unknown board '${board:-unknown}'"
		return 1
	fi

	if ! ax9000_load_config; then
		ax9000_write_fault "config_error:${AX9000_CONFIG_ERROR}"
		ax9000_prepare_controller >/dev/null 2>&1 || true
		ax9000_fan_full_speed >/dev/null 2>&1 || true
		ax9000_log "refusing invalid configuration: $AX9000_CONFIG_ERROR"
		return 1
	fi

	# Make one immediate fail-safe attempt before handing control to procd. A
	# transiently late hwmon/I2C device must not prevent the supervised daemon
	# from starting: the daemon keeps retrying until the controller is ready.
	if ! ax9000_prepare_controller; then
		ax9000_write_fault controller_not_found
		ax9000_fan_full_speed >/dev/null 2>&1 || true
		ax9000_log 'EMC2301/EMC2305 fan controller not ready; supervised retry will continue'
	fi

	# OpenWrt 25.12's procd.sh documents the instance name as optional, but its
	# _procd_open_instance helper unconditionally shifts one argument. Supplying
	# a stable name keeps BusyBox ash from reporting "shift count out of range"
	# on otherwise valid no-name calls.
	procd_open_instance fan_control
	procd_set_param command /usr/sbin/ax9000-fan-control
	procd_set_param pidfile "$AX9000_PIDFILE"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	# procd sends TERM first; this explicit write also covers a process that
	# has already crashed or is being removed during package uninstall.
	board=$(ax9000_board_name 2>/dev/null || true)
	if ax9000_supported_board "$board" && ax9000_find_fan; then
		ax9000_fan_full_speed >/dev/null 2>&1 || return 1
	fi
	[ -f "$AX9000_PIDFILE" ] && rm -f "$AX9000_PIDFILE"
}

reload_service() {
	stop
	start
}

service_status() {
	if [ -x /usr/libexec/ax9000-fan-status ]; then
		exec /usr/libexec/ax9000-fan-status
	fi
	return 1
}
